            "test_id": "REM-01",
            "description": "Active plan sends one T-2 reminder",
            "input": {
                "plan_id": "PLAN-REM-001",
                "initial_status": "Active",
                "frequency_days": 28,
                "completed_at": "2026-11-18",
                "expected_date": "2026-12-16",
                "runs": [
                    "2026-12-14T08:00:00+00:00"
                ],
                "fake_mail_failure_reason": null,
                "confirmed_cycles": []
            },
            "expected": {
                "attempts": 1,
                "count": 1,
                "events": [
                    "REMINDER_CREATED",
                    "EMAIL_SENT"
                ],
                "keys": [
                    "PLAN-REM-001@2026-12-16"
                ],
                "reminder_date": "2026-12-14",
                "reminder_status": "SENT",
                "sent_at": "2026-12-14T08:00:00+00:00"
            },
            "actual": {
                "attempts": 1,
                "count": 1,
                "events": [
                    "REMINDER_CREATED",
                    "EMAIL_SENT"
                ],
                "keys": [
                    "PLAN-REM-001@2026-12-16"
                ],
                "reminder_date": "2026-12-14",
                "reminder_status": "SENT",
                "sent_at": "2026-12-14T08:00:00+00:00"
            },
            "result": "PASS"
        },
